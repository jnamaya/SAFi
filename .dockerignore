# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# Environment (never bake secrets into the image)
.env
gateways/*.env
!gateways/*.env.example
# Local OpenCode config can contain a policy API key; it is not part of SAFi's
# runtime image.
opencode.json
opencode.jsonc

# Logs and runtime data
logs/
cache/
tts_cache/

# Development tools
Benchmarks/
tests/
docs/
.claude/
.agent/

# Node (Tailwind dev tooling)
public/node_modules/

# Git
.git/
.gitignore

# OS
.DS_Store
Thumbs.db
