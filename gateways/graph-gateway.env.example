# Graph gateway: per-user Microsoft 365 tools (docs/MCP_TOOLS.md section 5).
#
# Copy to graph-gateway.env in this directory, fill it in, chmod 600. It is
# gitignored; the .example is not. This file belongs to the GATEWAY process,
# never to SAFi's own .env: the gateway is a separate authorization server and
# mixing the two would put an Entra client secret in the app's environment for
# no reason.
#
# Start it with:  docker compose --profile gateways up -d
#
# GATEWAY_DB and PORT are deliberately NOT here. Compose sets both, so the
# sqlite store always lands on the named volume. Setting GATEWAY_DB to a path
# inside the image would put every member's stored token on ephemeral storage
# and log them all out on the next `up --build`.

# The gateway's PUBLIC https URL, as a browser reaches it. Not a compose
# service name: this exact origin is what you register at Entra as the
# redirect URI, and what `safi_mcp.py add --url` records. Compose publishes
# the container's 8403; terminate TLS in front of it and point that hostname
# here.
GATEWAY_BASE_URL=https://graph-gw.example.com

# An Entra app registration (Web platform) whose redirect URI is
# {GATEWAY_BASE_URL}/microsoft/callback, holding delegated Graph permissions
# User.Read, Files.Read.All, Sites.Read.All, Mail.ReadBasic, Calendars.Read.
# Mail.ReadBasic, not Mail.Read: the wider scope grants message bodies that no
# tool in this gateway reads.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# A tenant id pins sign-in to one tenant. The default accepts any work or
# school account.
ENTRA_TENANT=organizations

# Fernet key encrypting stored Microsoft tokens at rest. Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEEP IT. A new key does not lose the stored tokens, it makes them
# undecryptable, which fails at tool-call time rather than at sign-in and is
# therefore harder to diagnose than losing them outright.
GATEWAY_ENCRYPTION_KEY=
