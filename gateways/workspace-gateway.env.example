# Workspace gateway: per-user Google tools (docs/MCP_TOOLS.md section 5).
#
# Copy to workspace-gateway.env in this directory, fill it in, chmod 600. It is
# gitignored; the .example is not. This file belongs to the GATEWAY process,
# never to SAFi's own .env: the gateway is a separate authorization server and
# mixing the two would put a Google client secret in the app's environment for
# no reason.
#
# Start it with:  docker compose --profile gateways up -d
#
# GATEWAY_DB and PORT are deliberately NOT here. Compose sets both, so the
# sqlite store always lands on the named volume. Setting GATEWAY_DB to a path
# inside the image would put every member's stored token on ephemeral storage
# and log them all out on the next `up --build`.

# The gateway's PUBLIC https URL, as a browser reaches it. Not a compose
# service name: this exact origin is what you register at Google as the
# redirect URI, and what `safi_mcp.py add --url` records. Compose publishes
# the container's 8402; terminate TLS in front of it and point that hostname
# here.
GATEWAY_BASE_URL=https://gw.example.com

# A Google Cloud OAuth client (Web application) whose redirect URI is
# {GATEWAY_BASE_URL}/google/callback, with the Calendar, Drive and Gmail
# read-only scopes enabled on its consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Fernet key encrypting stored Google tokens at rest. Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEEP IT. A new key does not lose the stored tokens, it makes them
# undecryptable, which fails at tool-call time rather than at sign-in and is
# therefore harder to diagnose than losing them outright.
GATEWAY_ENCRYPTION_KEY=
