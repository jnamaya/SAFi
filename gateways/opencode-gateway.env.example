# OpenCode gateway: connects OpenCode to a SAFi policy over OpenAI-compatible
# chat completions. Keep this gateway-side key identical to the API key used by
# OpenCode's provider configuration. This file is gitignored; never bake it into
# the image or share it with a project.
#
# Setup:
#   cp gateways/opencode-gateway.env.example gateways/opencode-gateway.env
#   chmod 600 gateways/opencode-gateway.env
#   Fill in the policy API key, then start:
#   docker compose --profile opencode up -d opencode-gateway
#
# OpenCode on this same machine can use http://127.0.0.1:5002/v1. For another
# machine, leave this port private and expose the gateway through a TLS proxy.

SAFI_POLICY_API_KEY=
