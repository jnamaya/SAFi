# ══════════════════════════════════════════════════════════════════════════════
#  SAFi Environment Configuration
#
#  You do not have to edit this file by hand. Run:
#
#      python3 scripts/setup.py
#
#  It asks four questions, generates every secret below, and writes .env — this
#  same file with the values filled in, comments and all. Use --defaults for a
#  non-interactive install.
#
#  To configure it yourself instead, copy this file to .env and set:
#    1. DB_PASSWORD and MYSQL_ROOT_PASSWORD to anything secure
#    2. At least one AI provider API key (GROQ is free to start)
#    3. SAFI_LOCAL_ADMIN_EMAIL and _PASSWORD for persistent login
#    4. Then run: docker compose up
# ══════════════════════════════════════════════════════════════════════════════


# ── Application ───────────────────────────────────────────────────────────────

# TWO switches use the word "production" and they are independent. Both matter:
#
#   FLASK_ENV            = STRICTNESS. 'production' refuses to start without
#                          FLASK_SECRET_KEY, DB_PASSWORD, Google OAuth creds and
#                          SAFI_ENCRYPTION_KEY. Anything else skips those checks
#                          — including the encryption one, so a dev instance can
#                          silently store prompts and ledgers in PLAINTEXT.
#   SAFI_DEPLOYMENT_MODE = AUDIENCE. production | trial | showcase, controlling
#                          demo login and the showcase UI. Set further below.
#
# Typical pairs: laptop = development/trial · customer = production/production
#                public demo = production/showcase
FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-secure-random-key

# ── Encryption at Rest ────────────────────────────────────────────────────────
# Master key for application-level encryption of OAuth tokens and user content
# (Fernet). REQUIRED in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: comma-separated list — FIRST key encrypts new writes, ALL keys
# decrypt. Prepend a new key, then re-run scripts/backfill_encryption.py.
# WARNING: back this key up outside the server. Losing it makes all encrypted
# data permanently unreadable.
SAFI_ENCRYPTION_KEY=

# The public URL where SAFi is reachable (used for OAuth callbacks).
# For local Docker: http://localhost:5000
WEB_BASE_URL=http://localhost:5000

# Comma-separated list of origins allowed to make API requests.
# For local Docker: http://localhost:5000
# If you're running the mobile/ Capacitor app against this instance, also
# include the spoofed local origin(s) from mobile/capacitor.config.ts
# (server.hostname) — e.g. https://selfalignmentframework.com — or native
# cross-origin fetches (guest login, etc.) will fail CORS silently.
# Setting this var at all replaces the built-in default list entirely
# (safi_app/config.py), so omitting the mobile origin here drops it even
# though the code fallback includes it.
ALLOWED_ORIGINS=http://localhost:5000

# Allow session cookies over HTTP (set to False for local http:// installs)
SESSION_COOKIE_SECURE=False

# Exposed port (optional — change if 5000 is already in use)
APP_PORT=5000


# ── Database ──────────────────────────────────────────────────────────────────

# In Docker Compose, DB_HOST is automatically set to 'db' by the compose file.
# Only set this manually for external/existing database servers.
DB_HOST=db
DB_USER=safi
DB_NAME=safi

# Choose a strong password — used by both the app and the MySQL container.
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password


# ── AI Provider API Keys ──────────────────────────────────────────────────────
# At least one key is required. The others are optional.
#
# Free tiers available:
#   Groq:     https://console.groq.com          (fast, generous free tier)
#   Google:   https://aistudio.google.com        (Gemini free tier)
#   DeepSeek: https://platform.deepseek.com      (very cheap)
#
# Paid:
#   OpenAI:    https://platform.openai.com
#   Anthropic: https://console.anthropic.com
#   Mistral:   https://console.mistral.ai

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
ZHIPU_API_KEY=


# ── Google OAuth (required for user login) ────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include: {WEB_BASE_URL}/api/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Native (Capacitor) app Google Sign-In client id(s), comma-separated. The
# mobile app uses its own OAuth client, so its ID tokens carry a different
# audience than GOOGLE_CLIENT_ID; list those ids here so mobile login works.
GOOGLE_MOBILE_CLIENT_IDS=

# Optional: for Maps/Places features
GOOGLE_MAPS_API_KEY=


# ── Microsoft OAuth (optional) ────────────────────────────────────────────────
# Create an app at: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=


# ── GitHub OAuth (currently unused) ──────────────────────────────────────────
# The GitHub data-source connector was retired 2026-08-15 in favour of
# GitHub's official MCP server (see GITHUB_MCP_* below). These two variables
# are kept only as the reserved slot if GitHub SIGN-IN to SAFi is ever added;
# nothing reads them today.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitHub official MCP server (optional) ────────────────────────────────────
# An OAuth App at https://github.com/settings/developers whose callback is
# {WEB_BASE_URL}/api/mcp/auth/github_mcp/callback. Install with:
#   scripts/safi_mcp.py add --url https://api.githubcopilot.com/mcp --auth oauth \
#     --key github_mcp --client-id '${GITHUB_MCP_CLIENT_ID}' \
#     --client-secret '${GITHUB_MCP_CLIENT_SECRET}' --scopes "read:user,read:org"
GITHUB_MCP_CLIENT_ID=
GITHUB_MCP_CLIENT_SECRET=


# ── SAFi Runtime Settings (optional — defaults shown) ────────────────────────

# AI models for each faculty — LEAVE UNSET TO AUTO-DETECT. SAFi picks sensible
# defaults from the first provider key you configured above, so a fresh install
# needs no model configuration at all. Once you're familiar with the system,
# uncomment any of these to pin a specific model (the value must belong to a
# provider whose API key is set). Example values shown:
#SAFI_INTELLECT_MODEL=claude-haiku-4-5-20251001
#SAFI_CONSCIENCE_MODEL=openai/gpt-oss-120b
#SAFI_SUMMARIZER_MODEL=openai/gpt-oss-20b
#SAFI_BACKEND_MODEL=openai/gpt-oss-20b

# Default agent loaded on first login. The Fiduciary shows what SAFi is for in
# one interaction — a regulated-domain agent declining to give personalised
# financial advice — and needs no knowledge base.
# Org that turns from the public/embedded bot (/api/public/process_prompt) are
# attributed to. Leave unset and those turns record org_id = NULL, which matches
# nothing in SQL — the record exists but is invisible to every Audit Hub view and
# to both exports. Set it if you want the public bot auditable.
SAFI_PUBLIC_ORG_ID=

SAFI_PROFILE=fiduciary

# Which built-in demo agents to enable. The default three all run with zero
# extra setup:
#   fiduciary (regulated-domain governance — no RAG)
#   tutor     (Socratic Tutor — no RAG)
#   safi      (SAFi Steward — explains the system; its small index auto-builds)
# Set to "all" for the full suite, or any comma-separated list of these keys:
#   fiduciary, tutor, safi, health_navigator, bible_scholar
# health_navigator also needs no RAG. Only bible_scholar requires an index to
# be built first — see rag/build_index_v2.py.
#SAFI_BUILTIN_AGENTS=fiduciary,tutor,safi

# Code-defined extension agents, loaded from a directory OUTSIDE the package.
# Each *.py file in this directory must define KEY (the agent's registry key)
# and AGENT (the agent dict, same shape as the built-ins). Installing the file
# is the enablement: extension keys do not need listing in SAFI_BUILTIN_AGENTS,
# and an extension can never shadow a built-in key. Loading EXECUTES the file,
# so only point this at a directory you control; it is equivalent in trust to
# installing the package itself. Unset (default) turns the feature off.
# Extension agents compile through the same governance as everything else.
#SAFI_EXTENSIONS_DIR=/opt/safi-extensions

# Models for background work: the note-taker (per-agent work memory) and the
# public/embedded chatbot (isolated from users' model selections). Also
# auto-detected when unset; uncomment to override.
#SAFI_NOTETAKER_MODEL=gemini-3.5-flash-lite
#SAFI_PUBLIC_INTELLECT_MODEL=gemini-3.5-flash-lite
#SAFI_PUBLIC_CONSCIENCE_MODEL=openai/gpt-oss-120b

# Daily prompt limit per user (0 = unlimited)
SAFI_DAILY_PROMPT_LIMIT=0

# What this instance is. One declaration instead of several demo switches:
#
#   production  demo login off, showcase framing off. Use this for any real
#               deployment. This is also the default if you set nothing.
#   trial       demo login on, showcase framing off. Evaluate locally without
#               configuring OAuth. Shipped below because that is what the
#               Quick Start needs — change it to production before anyone
#               other than you uses the instance.
#   showcase    demo login on, showcase framing on (names the running model
#               and explains that SAFi is the governance layer, not the
#               intelligence). Only a public demo instance should be this:
#               inside your own deployment the staff using the agent are not
#               the audience, and disclaiming the intelligence just erodes
#               trust in the tool.
#
# An unrecognised value falls back to production and logs a warning at startup.
SAFI_DEPLOYMENT_MODE=trial

# Individual overrides. Only needed to depart from the mode above; each one
# wins over the mode when set, which is also why an older .env that sets these
# directly keeps working unchanged.
# SAFI_ENABLE_DEMO=true
# SAFI_PUBLIC_DEMO_UI=true
# Default Intellect model for fresh demo accounts (guests can still switch).
# Leave blank to inherit the global default, which follows your configured
# provider key. Only set a model here if its provider's API key is set above;
# a model from an unconfigured provider is ignored at guest creation.
SAFI_DEMO_INTELLECT_MODEL=

# Persistent local admin account (no OAuth required).
# When both vars are set, a permanent admin account is auto-created/updated on startup.
# Ideal for self-hosted instances and local development.
# Leave blank to disable local login entirely.
SAFI_LOCAL_ADMIN_EMAIL=admin@localhost
SAFI_LOCAL_ADMIN_PASSWORD=change-me-local-password

# Super admins (deployment operators): comma-separated emails granted
# deployment-wide visibility — currently the whole-deployment usage rollup in
# the Usage & Cost tab (token spend per org, including public traffic).
# Leave blank to disable super-admin access entirely, the safe default.
SAFI_SUPER_ADMINS=

# Tenancy: single (default) means this instance serves exactly one
# organization — whoever logs in first founds it and becomes its admin,
# everyone after joins that same org automatically. That is almost always
# what a self-hosted clone wants, so it needs no configuration. Set to
# "multi" only for a deployment meant to serve more than one organization
# (the public online demo runs multi — do not copy that setting here).
# An unrecognised value falls back to single and logs a warning at startup.
SAFI_TENANCY_MODE=single

# Single-tenant advanced/migration override: pin to a specific existing org
# id instead of auto-detecting the deployment's oldest org. Leave blank in
# the normal case — a fresh install has no org yet to pin. Ignored when
# SAFI_TENANCY_MODE=multi.
SAFI_SINGLE_TENANT_ORG_ID=

# Max sequential tool-call turns per request before forcing a final answer (default: 5)
SAFI_MAX_AGENT_TURNS=5

# Output-token budget for the Intellect's generation (default: 8192). An answer
# that stops mid-sentence has hit this. On a thinking model the budget also pays
# for reasoning you never see, so the visible answer can be a fraction of it.
# Raise it for long document work; a bigger budget means a longer generation, so
# check SAFI_LLM_TIMEOUT and SAFI_GUNICORN_TIMEOUT before going much higher.
SAFI_MAX_INTELLECT_TOKENS=8192

# Plaintext JSONL debug logs on disk (default: false). The governance system
# of record is the encrypted governance_records table — leave this off unless
# you are debugging the pipeline locally.
SAFI_DEBUG_JSONL_LOGS=false
SAFI_LOG_DIR=logs
SAFI_LOG_TEMPLATE={profile}-%Y-%m-%d.jsonl
# Days to keep dated log files before the purge script deletes them
# (blank/0 = keep forever; deletion respects legal holds).
SAFI_LOG_RETENTION_DAYS=

# Text-to-speech. "edge-tts" is free and needs no key;
# "voxtral-mini-tts-2603" (Mistral) requires MISTRAL_API_KEY;
# "gpt-4o-mini-tts" requires OPENAI_API_KEY; "gemini-*" requires GEMINI_API_KEY.
SAFI_TTS_MODEL=edge-tts
SAFI_TTS_VOICE=en-US-AvaMultilingualNeural
# Mistral TTS preset voice slug (GET https://api.mistral.ai/v1/audio/voices
# lists them, e.g. en_paul_neutral, gb_jane_neutral, gb_oliver_neutral)
SAFI_MISTRAL_TTS_VOICE=en_paul_neutral
# Cached synthesized audio expires after this many days (0 = never cache)
SAFI_TTS_CACHE_TTL_DAYS=7

# HMAC secret for signing monitoring-alert webhooks (X-SAFi-Signature).
# Required only if an org configures an alert webhook URL.
SAFI_WEBHOOK_SECRET=

# Alignment threshold the enforcement gate applies (0.0–1.0) and MySQL pool size
SAFI_SPIRIT_THRESHOLD=0.5
SAFI_DB_POOL_SIZE=10

# Agent work-memory extraction tuning (defaults shown)
SAFI_AGENT_MEMORY_TEMPERATURE=0.0
SAFI_AGENT_MEMORY_MAX_ITEMS=80

# Character budget for the work-context memory injected into the prompt each
# turn. Stored memory is never truncated: oldest entries are left out of the
# injection and the model is told so. 0 disables the budget.
SAFI_AGENT_MEMORY_MAX_CHARS=12000

# Spirit memory EMA smoothing factor (0.0–1.0, higher = longer memory)
SAFI_SPIRIT_BETA=0.9

# Maximum document upload size and character extraction limit.
# Images (.png/.jpg/.tiff/.webp/.bmp) and scanned PDFs are read by OCR and count
# against the same character limit as any other attachment. OCR needs the
# tesseract-ocr system package; without it images are refused with a clear
# message and text documents are unaffected.
SAFI_MAX_UPLOAD_MB=10
SAFI_MAX_DOC_CHARS=50000

# How much of the conversation is replayed verbatim to the faculties each turn,
# in USER/ASSISTANT PAIRS. "all" (or 0) keeps every prior turn — some agents need
# the whole thread; most do not and should not pay for it.
#
# SAFI_HISTORY_MAX_CHARS bounds it either way, because the window goes to the
# Intellect AND into the Conscience's audit material, and the Conscience has no
# budget of its own. Uncapped, a long thread carrying one large attachment
# re-sends it on every later turn, twice. When the budget bites, the oldest whole
# turns are dropped and the prompt says so.
#
# A single agent can override both on its persona: history_turns,
# history_max_chars.
SAFI_HISTORY_TURNS=3
SAFI_HISTORY_MAX_CHARS=40000

# Measured boot. At startup SAFi hashes its Core Loop files against the release
# manifest and logs the result; the fingerprint and intact/tainted state are
# also stamped into every governance record, so each audit record names the
# Trusted Computing Base (TCB) that produced it. Default (unset) is warn-and-run: a modified tree
# boots, loudly, and its records say "modified" — running modified code is an
# AGPL right; representing it as SAFi is what needs an intact TCB (agreement
# Section IV). Set to "strict" to refuse startup on anything but verified-intact
# (regulated deployments). Verify by hand: python scripts/verify_integrity.py
SAFI_ENFORCE_INTEGRITY=

# TCB Fingerprint pin (optional, recommended for production). Copy the value from
# the official release's "TCB Fingerprint:" line on GitHub — never from your own
# tree; the whole point is that a human verified it out of band. When set,
# every boot compares the measured TCB fingerprint against it: a mismatch logs
# loudly, and refuses startup under SAFI_ENFORCE_INTEGRITY=strict. Update the
# pin deliberately when you upgrade — that update is you re-checking the new
# release's published value.
SAFI_EXPECTED_FINGERPRINT=

# Seconds gunicorn allows a single request. Raised from 120: a large attachment
# through a slow model can exceed two minutes. 300 matches the Apache `Timeout`
# in front of the bare-metal deployment — past that the proxy cuts first, so both
# must move together. Note that exceeding it kills the worker, not just the
# request, so this reduces how often that happens rather than the impact when it
# does. (Docker deployments only; the systemd unit carries its own --timeout.)
SAFI_GUNICORN_TIMEOUT=300

# ── MCP tool servers (optional) ──────────────────────────────────────────────
# Path to the JSON file listing the MCP servers this deployment installs. The
# shipped file is empty, which means "no MCP tools", the normal case. See
# docs/MCP_TOOLS.md for the format and mcp_servers.example.json for a worked
# example.
#
# This file is the ONLY way to install a tool server, deliberately: a stdio
# server is an arbitrary command the app process executes, so installing one is
# deployment-level trust, the same as SAFI_EXTENSIONS_DIR. No API route and no
# admin screen can add one. What an organization's admin controls is which
# installed connectors their members and agents may use.
#
# Servers connect once per worker process at boot, so a stdio server means one
# subprocess per gunicorn worker (4 in the container). Prefer http for anything
# expensive to run.
#
# The path below is the in-package default and is fine for a quick local run.
# For a real deployment point it OUTSIDE the checkout: Docker Compose already
# does (/app/mcp/servers.json on a mount), and on bare metal upgrades are
# `git pull` over a tracked file, so servers written here would block the pull
# or be replaced by it. Something like /home/safi/mcp-servers.json.
MCP_SERVERS_JSON=./safi_app/core/mcp_servers/mcp_servers.json

# The registry scripts/safi_mcp.py searches. The default is the official one,
# which verifies that a publisher owns the name they published under and reviews
# no code. Point it at a private mirror if you run one. Nothing in the browser
# reads this: installation is an operator action on the host.
SAFI_MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io

# ── Outbound email (optional — Scheduled Updates, invite claim links) ───────
# SAFi sends email in exactly two places: delivering a scheduled task's
# approved output to its owner's account address, and emailing an invited
# member a one-time link to set a password and join (backlog 51) — the only
# way in for someone with no Google or Microsoft account on their domain.
# Leave unset and Scheduled Updates reports "email not configured", and
# invitations still work but only for invitees who sign in with a matching
# Google or Microsoft account; no claim link is ever generated without this.
# STARTTLS is used; port 587 is the usual choice.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ── Channel bots (optional — teams_bot.py / telegram_bot.py) ─────────────────
# The bots authenticate to /api/bot/process_prompt with a POLICY API KEY
# minted in the SAFi policy UI (stored in the api_keys table).
SAFI_BOT_POLICY_API_KEY=
# Persona the bot speaks as (an agent key from your instance)
SAFI_BOT_PERSONA=
# Telegram only: the token @BotFather gives you
TELEGRAM_BOT_TOKEN=
# Teams only: Azure bot registration
# MicrosoftAppId= / MicrosoftAppPassword= / MicrosoftAppTenantId=

# Legacy shared secret (unused by current bots; kept for config validation)
SAFI_BOT_API_SECRET=change-me
