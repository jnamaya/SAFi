#!/bin/bash
# SAFi Appliance — first-boot wizard.
#
# Runs once (guard: /var/lib/safi-firstboot/done), inside the installed
# system, before the login prompt. It is the old-PBX "configuration wizard":
# the repo's own scripts/setup.py generates .env interactively, then this
# script wires the pieces bare metal needs that setup.py cannot know about:
#   • the system MySQL instance (setup.py and DEPLOY_BAREMETAL's DB vars)
#   • the reverse-proxy backend port (5001) vs. docker's default 5000
#   • the `admin` operator password
#   • enabling the SAFi service units / timers
#
# Idempotent and re-runnable: `rm /var/lib/safi-firstboot/done && re-run`.

set -euo pipefail

APP_DIR=/var/www/safi
STATE_DIR=/var/lib/safi-firstboot
DONE="$STATE_DIR/done"

[ -e "$DONE" ] && exit 0

cd "$APP_DIR"

echo
echo "================   SAFi Appliance — first-run setup   ================"
echo "You will be asked a handful of questions (provider key, admin account,"
echo "network). Everything else is generated. The admin password is shown once"
echo "at the end — write it down; it is also kept in $APP_DIR/.env."
echo "======================================================================="
echo

# 1. Generate .env from the repo's own wizard (asks questions on this console).
#    setup.py imports only the standard library, so no venv is required yet.
#    It is interactive; stdin is wired to tty1 by safi-firstboot.service.
python3 scripts/setup.py

chown safi:safi .env
chmod 600 .env

# 2. Bare-metal overrides that setup.py (written against docker-compose) can't
#    know: compose forces DB_HOST=db; bare metal talks to the local socket.
#    The app server listens on 5001 (deploy/systemd/safi.service); the wizard's
#    APP_PORT question is cosmetic here — the reverse proxy owns :80.
sed -i 's#^DB_HOST=.*#DB_HOST=localhost#' .env
sed -i 's#^APP_PORT=.*#APP_PORT=5001#' .env

# 3. Create the database + user from the .env values just generated. Tables are
#    built by the app's init_db() on first start, so nothing more is needed.
DB_NAME=$(sed -n 's/^DB_NAME=//p' .env)
DB_USER=$(sed -n 's/^DB_USER=//p' .env)
DB_PASS=$(sed -n 's/^DB_PASSWORD=//p' .env)
mysql --protocol=socket -u root <<SQL
CREATE DATABASE IF NOT EXISTS \`$DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '$DB_USER'@'localhost' IDENTIFIED BY '$DB_PASS';
GRANT ALL PRIVILEGES ON \`$DB_NAME\`.* TO '$DB_USER'@'localhost';
FLUSH PRIVILEGES;
SQL

# 4. If the operator left the wizard's default (localhost:5000), retarget the
#    public URL at the appliance's own :80 so the proxy is actually used.
if grep -q '^WEB_BASE_URL=http://localhost:5000$' .env; then
    IP=$(hostname -I 2>/dev/null | awk '{print $1}')
    [ -z "${IP:-}" ] && IP=$(ip route get 1 2>/dev/null | sed -n 's/.*src \([0-9.]*\).*/\1/p')
    if [ -n "${IP:-}" ]; then
        sed -i "s#^WEB_BASE_URL=.*#WEB_BASE_URL=http://$IP/#" .env
        sed -i "s#^ALLOWED_ORIGINS=.*#ALLOWED_ORIGINS=http://$IP/#" .env
        echo "Public URL set to http://$IP/  (reverse proxy on :80)."
        echo "If you plan to browse via a hostname, edit WEB_BASE_URL / ALLOWED_ORIGINS in .env."
    fi
fi

# 5. Operator console password (account started locked — no credentials on ISO).
echo
echo "Set a password for the 'admin' operator account (console + SSH)."
passwd admin

# 6. Bring the appliance up. safi.service will not have started earlier: it was
#    never enabled until now, precisely because .env did not exist.
systemctl daemon-reload
systemctl enable --now mysql apache2 ssh >/dev/null 2>&1
systemctl enable --now \
    safi \
    safi-kb-indexer \
    safi-retention-purge.timer safi-backup.timer safi-backup-verify.timer >/dev/null

# 7. Warm the embedding model if the build-time warm was skipped (offline build).
su -s /bin/sh safi -c \
    "./venv/bin/python -c \
     'from safi_app.core.services.retriever import get_shared_embedding_model as g; g(); print(\"embedding model warmed\")'" \
    || true

touch "$DONE"

IP=$(hostname -I 2>/dev/null | awk '{print $1}')
echo
echo "==============   SAFi Appliance setup complete   ======================"
echo "  Web UI      : http://${IP:-<this host>}/"
echo "  Admin login : the email/password printed above by the SAFi wizard"
echo "  Services    : systemctl status safi  ·  journalctl -u safi -f"
echo "  Operator    : login as 'admin' on this console or via SSH"
echo "  Next        : a prompt is waiting at the login console."
echo "======================================================================="
echo