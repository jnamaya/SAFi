[Unit]
Description=SAFi network sanity check + SSH host keys
Before=safi-browser-setup.service ssh.service network-online.target
After=systemd-udevd.service
Wants=systemd-udevd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/safi-net-prep.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target