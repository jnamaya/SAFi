[Unit]
Description=SAFi AMD GPU tuning (clock governor, TTM GTT pool, THP)
After=local-fs.target systemd-modules-load.service
Before=safi-browser-setup.service safi.service safi-llama-server.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/safi-gpu-tune.sh

[Install]
WantedBy=multi-user.target