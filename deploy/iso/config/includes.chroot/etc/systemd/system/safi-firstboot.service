[Unit]
Description=SAFi Appliance first-boot configuration wizard
Documentation=https://github.com/jnamaya/SAFi/blob/dev/deploy/iso/README.md
# Runs once; a completed run writes /var/lib/safi-firstboot/done.
ConditionPathExists=!/var/lib/safi-firstboot/done
After=network-online.target
Wants=network-online.target
# Claim tty1 for the interactive wizard, then hand it back to the login prompt.
Conflicts=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/safi-firstboot
StandardInput=tty
TTYPath=/dev/tty1
# Do not kill the wizard mid-question when the operator pauses to read.
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target