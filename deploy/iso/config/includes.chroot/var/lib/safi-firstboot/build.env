# Source of truth for what the appliance ISO was built from.
# Consumed by config/hooks/normal/030-bootstrap-safi.chroot (inside the build
# chroot). auto/config mirrors SAFI_REF for the ISO label only.
#
# SAFI_REF must be a release tag, not a branch — production installs pin a
# release and verify a TCB fingerprint (docs/RELEASE_PROCESS.md). Keep this in
# step with auto/config when you build a different release.
SAFI_REF=v1.4.1
SAFI_GIT_URL=https://github.com/jnamaya/SAFi.git