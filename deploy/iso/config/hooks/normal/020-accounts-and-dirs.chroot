#!/bin/sh
# 020 — Accounts and directory skeleton that must exist before the 030
# bootstrap clone. Mirrors DEPLOY_BAREMETAL.md step 3 (service user) plus the
# appliance's operator account.
set -eu

# Service account, exactly as deploy/systemd/*.service expect:
#   User=safi  Group=www-data  WorkingDirectory=/var/www/safi
# shell nologin: it runs services, nobody logs in as it.
# The GPU render node is root:render (card0 is root:video); without these
# groups llama-server cannot open /dev/dri/renderD128 and silently falls back
# to CPU, making the appliance ~2x slower with no error in the journal.
getent group render >/dev/null 2>&1 || groupadd --system render
getent group video >/dev/null 2>&1 || groupadd --system video
id safi >/dev/null 2>&1 || \
    useradd --system --user-group --create-home --groups render,video \
            --home-dir /home/safi --shell /usr/sbin/nologin safi
# Existing accounts may predate the groups above, so ensure membership.
usermod -aG render,video safi
chown -R safi:safi /home/safi

# Operator account (console + SSH), password LOCKED until the first-boot wizard
# sets it, so the shipped ISO has no known credentials.
# Groups: sudo (root access), adm + systemd-journal (read journalctl without
# sudo — `admin@safi:~$ journalctl -u safi` must Just Work).
if ! id admin >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash --groups sudo,adm,systemd-journal admin
fi
passwd -l admin >/dev/null 2>&1 || true

# App tree + runtime dirs the Dockerfile creates, so the clone below can chown
# them in one go. /var/lib/safi-firstboot stores browser-setup state.
mkdir -p /var/www/safi
mkdir -p /var/www/safi/logs /var/www/safi/cache /var/www/safi/vector_store /var/www/safi/mcp
mkdir -p /var/lib/safi-firstboot
chown -R safi:safi /var/www/safi
