#!/bin/sh
# 070 — Bundle the pinned llama-server runtime and the local-model catalogue.
#
# This hook installs the *runtime*, never a model. Weights are fetched on the
# installed system by the setup wizard (safi-browser-setup.py ->
# safi-model-fetch.service), because ISO 9660 caps a file at 4 GiB-1 and every
# useful local model is larger than that, and because a 5 GB download has no
# business being baked into an image that may sit on a build server for weeks.
#
# Two consequences worth stating, because they used to be the other way round:
#
#   * No gguf-split sharding. A 20 GB GGUF written to ext4/LUKS is just a file;
#     the ISO 9660 limit that forced -00001-of-00002 shards does not apply.
#   * safi-llama-server.service is NOT enabled here. With no model on disk it
#     would crash-loop on every boot. safi-model-fetch writes and enables the
#     unit after a verified download.
#
# The CPU tarball is pinned so a rebuild cannot silently ship a different
# inference binary, and it is small enough to always carry: 17 MB compressed is
# what makes the "no model yet" state functional rather than broken. A CUDA
# backend is ~765 MB and is fetched on demand only when a usable GPU is found.
set -eu

LLAMA_URL="https://github.com/ggml-org/llama.cpp/releases/download/b11205/llama-b11205-bin-ubuntu-x64.tar.gz"
LLAMA_SHA256="730ea8e54b97735abb46e46747999249719251f29753fcda97b5e2f2f3ea6912"

BIN_DIR=/opt/safi/bin
MODEL_DIR=/var/lib/safi/models
STAGE_DIR=/usr/local/sbin/safi-appliance-stage
TMP_DIR=/tmp/safi-llama-runtime
mkdir -p "$BIN_DIR" "$MODEL_DIR" /etc/safi "$TMP_DIR"

download_checked() {
    url=$1
    destination=$2
    expected=$3
    curl --fail --location --retry 3 --retry-delay 2 --silent --show-error \
        "$url" -o "$destination"
    actual=$(sha256sum "$destination" | cut -d' ' -f1)
    if [ "$actual" != "$expected" ]; then
        echo "local model: checksum mismatch for $destination" >&2
        echo "  expected: $expected" >&2
        echo "  actual:   $actual" >&2
        exit 1
    fi
}

download_checked "$LLAMA_URL" "$TMP_DIR/llama.tar.gz" "$LLAMA_SHA256"
tar -xzf "$TMP_DIR/llama.tar.gz" -C "$BIN_DIR"

# Release archives may contain a top-level directory. Flatten the whole
# release directory so llama-server and every adjacent shared library land in
# one directory; the systemd unit can then use one deterministic library path.
server=$(find "$BIN_DIR" -type f -name llama-server -print -quit)
if [ -z "$server" ]; then
    echo "local model: llama-server missing from pinned archive" >&2
    exit 1
fi
if [ "$server" != "$BIN_DIR/llama-server" ]; then
    release_dir=$(dirname "$server")
    cp -a "$release_dir"/. "$BIN_DIR"/
    rm -rf "$release_dir"
fi
chmod 0755 "$BIN_DIR/llama-server"

# The catalogue and the shared helper are staged in includes.chroot because
# /etc/safi and /usr/local/lib are not writable in a non-root checkout; install
# them into their real homes and drop the staging copies so nothing stale can
# be mistaken for the live copy.
if [ -f "$STAGE_DIR/local-models.json" ]; then
    install -Dm0644 "$STAGE_DIR/local-models.json" /etc/safi/local-models.json
fi
if [ -f "$STAGE_DIR/safi_local.py" ]; then
    install -Dm0644 "$STAGE_DIR/safi_local.py" /usr/local/lib/safi_local.py
fi
rm -rf "$STAGE_DIR"

# Placeholders so the paths exist even before the operator chooses a model.
# safi-model-fetch overwrites the env file and writes the unit itself.
#
# SAFI_LOCAL_JEV_PATH is deliberately not written here. The app probes the
# default bundle location when that variable is absent and reads an empty value
# as "off", so a stock appliance picks the bundle up once the fetch installs it
# and nothing has to coordinate a path between this hook and the fetcher.
cat > /etc/safi/llama-server.env <<'EOF'
# Written by safi-model-fetch once a model is chosen. These defaults let an
# operator start the server by hand before then; the server stays loopback-only.
SAFI_LOCAL_MODEL_CONTEXT=8192
SAFI_LOCAL_MODEL_THREADS=0
SAFI_LOCAL_MODEL_GPU_LAYERS=0
EOF
chmod 0644 /etc/safi/llama-server.env

chown -R root:root /opt/safi /etc/safi "$MODEL_DIR"
chmod 0755 /opt/safi "$BIN_DIR" "$MODEL_DIR"
rm -rf "$TMP_DIR"
