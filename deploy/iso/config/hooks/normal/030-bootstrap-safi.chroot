#!/bin/sh
# 030 — Bootstrap SAFi into the ISO rootfs (the "status: exists" part).
#
# Clones the pinned release, builds the virtualenv, pre-warms the embedding
# model, and stages every systemd unit from deploy/systemd/ so the installed
# system boots straight into the appliance. This is the long step: the venv is
# ~800 MB–1 GB and needs the build host online.
#
# Because the live-installer copies this rootfs verbatim to disk, none of this
# has to happen at first boot — the ISO is self-contained.
set -eu

. /var/lib/safi-firstboot/build.env

cd /var/www/safi

# Release tag, not branch — /var/lib/safi-firstboot/build.env (kept in step
# with auto/config). --depth 1 keeps the image small; .git is retained so the
# in-app TCB "branch/release" control reports a value.
#
# Source selection: production builds clone ${SAFI_GIT_URL} at ${SAFI_REF}.
# Private ISO builds pre-stage a shallow local clone at
# /var/cache/safi-src (see deploy/iso/stage-local-release.sh) so the appliance
# can be packaged with code that is not yet published as a tag — the stage is
# preferred when present and removed right after the clone so it never lands
# on the installed system.
#
# 020 created /var/www/safi with its runtime subdirs (logs/cache/mcp/
# vector_store), so git refuses to clone straight into it — and /var/www is
# root-owned, so the safi user could not create a sibling clone target. Clone
# and merge as root, then chown the whole tree before the venv steps run as
# safi. dotglob moves .git along with everything else.
if [ -d /var/cache/safi-src/.git ]; then
    SAFI_CLONE_SRC=/var/cache/safi-src
else
    SAFI_CLONE_SRC="${SAFI_GIT_URL}"
fi
git clone --depth 1 --branch "${SAFI_REF}" "${SAFI_CLONE_SRC}" /var/www/safi.repo
rm -rf /var/cache/safi-src
bash -c 'shopt -s dotglob; mv /var/www/safi.repo/* /var/www/safi/ && rmdir /var/www/safi.repo'
chown -R safi:safi /var/www/safi

cd /var/www/safi

# Virtualenv (DEPLOY_BAREMETAL.md step 4). uid is a system user so it gets no
# HOME prompts; pip cache stays under /home/safi, which 020 owned.
su -s /bin/sh safi -c "
    python3 -m venv venv && \
    ./venv/bin/pip install --upgrade pip && \
    ./venv/bin/pip install -r requirements.txt"

# Pre-warm the embedding model so the first KB-backed query doesn't stall a
# live request for ~90 MB (DEPLOY_BAREMETAL.md step 6; docker-entrypoint does
# this for containers, systemd never does).
su -s /bin/sh safi -c \
    "./venv/bin/python -c \
     'from safi_app.core.services.retriever import get_shared_embedding_model as g; g(); print(\"embedding model warmed\")'" \
    || echo "warm skipped (offline build?) — first boot will warm it"

# Everything the app may write at runtime must be writable by the service user.
chown -R safi:safi /var/www/safi

# Stage the appliance's systemd units (they ship inside the repo tree).
install -m 644 -o root -g root \
    deploy/systemd/safi.service \
    deploy/systemd/safi-retention-purge.service deploy/systemd/safi-retention-purge.timer \
    deploy/systemd/safi-backup.service deploy/systemd/safi-backup.timer \
    deploy/systemd/safi-backup-verify.service deploy/systemd/safi-backup-verify.timer \
    deploy/systemd/safi-kb-indexer.service \
    /etc/systemd/system/

 # Enable the browser-first setup service in the installed system. It runs BEFORE
# safi.service because nothing enables the app units until the browser has
# produced .env.
#
# mysql/apache/ssh are intentionally NOT enabled here: the browser setup service
# starts MySQL and Apache after the machine has booted and the setup certificate
# exists.
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf /etc/systemd/system/safi-browser-setup.service \
       /etc/systemd/system/multi-user.target.wants/safi-browser-setup.service
ln -sf /etc/systemd/system/safi-net-prep.service \
       /etc/systemd/system/multi-user.target.wants/safi-net-prep.service

# Keep the post-setup status dashboard on tty1. It never accepts local login;
# SSH is the only operator shell access path.
ln -sf /etc/systemd/system/safi-console.service \
       /etc/systemd/system/multi-user.target.wants/safi-console.service
# The setup + net-prep scripts must be executable; include.chroot sometimes
# loses the +x bit through git/live-build copies, and a 203/EXEC kills the
# whole first-boot path silently.
chmod 0755 /usr/local/sbin/safi-browser-setup.py
chmod 0755 /usr/local/sbin/safi-net-prep.py
chmod 0755 /usr/local/sbin/safi-console.py
chmod 0755 /usr/local/sbin/safi

# The browser-setup service owns tty1 (TTYPath=/dev/tty1) and prints the
# one-time PIN banner there. Mask every getty so no virtual console offers a
# local login. The dashboard itself is informational and never hands off to
# login; SSH is the operator shell access path.
mkdir -p /etc/systemd/system/getty.target.wants
for n in 1 2 3 4 5 6; do
    ln -sf /dev/null /etc/systemd/system/getty@tty${n}.service
done
ln -sf /dev/null /etc/systemd/system/serial-getty@ttyS0.service
ln -sf /dev/null /etc/systemd/system/getty-static.service
