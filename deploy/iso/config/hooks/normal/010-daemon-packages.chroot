#!/bin/sh
# 010 — Install daemon packages safely inside the build chroot.
#
# mysql-server / apache2 / openssh-server are kept OUT of
# config/package-lists/ because their postinst scripts try to start a daemon
# and this chroot has no systemd boot. We install them here behind a
# policy-rc.d that answers 101 ("policy forbids"), so configuration completes
# but nothing starts. The real services start on first boot of the installed
# system; MySQL initialises its datadir on first start (no step needed here).
set -eu

cat >/usr/sbin/policy-rc.d <<'EOF'
#!/bin/sh
echo "policy-rc.d: service start blocked inside live-build chroot (SAFi appliance)" >&2
exit 101
EOF
chmod 755 /usr/sbin/policy-rc.d

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends \
    default-mysql-server \
    mariadb-client \
    apache2 \
    openssh-server

# These package postinsts could not persist their enable state with
# policy-rc.d in place; the installed system gets explicit enables below and in
# safi-firstboot, so nothing is left to chance.
true