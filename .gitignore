# Python virtual environment
/venv/

# Python cache files
__pycache__/
*.pyc

# Log files
logs/

# Database file (contains user memory and private data)
safi_memory.db

# Stray sqlite ":memory:" test-run artifact (do not ignore *.ses broadly;
# session_*.ses files are legitimate)
:memory:.ses

# Any local environment files (if you create them later)
.env
.env.*
!.env.example

# Gateway env files hold a Google/Entra client secret and the Fernet key over
# every member's stored upstream tokens. The .example templates are tracked.
gateways/*.env
!gateways/*.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
dist/
build/
.pytest_cache/
.coverage
htmlcov/
debug.py
whatsapp_bot.py
cache/

# Node / frontend
node_modules/
.next/
out/
coverage/
.cache/

# OS/editor
.DS_Store
Thumbs.db
.idea/

# SAFi workspace scratchpads and local state
.safi/
*.scratchpad.md

.vscode/
vector_store/
tts_cache/
tests/logs/
tests/__pycache__/

# Test files
test.py

# Benchmarks
/benchmarks

# Chat sub-project dependencies
chat/node_modules/
chat/package.json
chat/package-lock.json
chat/tailwind.config.js
chat/tailwindcss/

# Agent instructions — local, not for version control
.claude/
CLAUDE.md
AGENTS.md

# Local utility / dev scripts (not for version control)
driver.py
load.py
purge_profile.py

# Database backups / dumps
*.sql

# Local backups (e.g. policy values/weights snapshots)
.backups/

# Benchmark backup/scratch snapshots (top-level only; tracked results live in Benchmarks/Results & Scripts)
/Benchmarks/*.json

# Red-team session transcripts (--dump-sessions / --dump-interventions output).
# These contain raw user prompts from the demo; only the CSV worksheet and the
# aggregate summary JSON are publishable. Belt and braces against a stray commit.
*_review.jsonl
*sessions_review*
interventions.jsonl

# Local drafts / blog posts (not for version control)
docs/building-and-managing-agents-post.md

# Internal-only docs (gap analyses, security posture — never publish)
docs/internal/

# Static marketing site and retired venv. Host-local, never synced up
/static_site/
/venv.old/

# Staged local-release source snapshot (populated by stage-local-release.sh,
# consumed by hooks/normal/030-bootstrap-safi.chroot, never committed)
/deploy/iso/config/includes.chroot/var/cache/

# Lab PKI / deployment-only material (LDAPS CA cert, compose backups)
certs/
*.bak-*
*.db
